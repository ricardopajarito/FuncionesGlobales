{
    "Resources": {
        "FuncionesGlobalesRolLambdas": {
			"Type": "AWS::IAM::Role",
			"Properties": {
				"Path": "/",
				"RoleName": "FuncionesGlobalesRolLambdas",
				"Description": "Rol para las funciones globales",
				"AssumeRolePolicyDocument": {
					"Version": "2012-10-17",
					"Statement": [
						{
							"Effect": "Allow",
							"Principal": {
								"Service": [
									"lambda.amazonaws.com"
								]
							},
							"Action": [
								"sts:AssumeRole"
							]
						}
					]
				},
				"Policies": [
					{
						"PolicyName": "LambdaPolicy",
						"PolicyDocument": {
							"Version": "2012-10-17",
							"Statement": [
								{
									"Effect": "Allow",
									"Action": [
										"lambda:ListFunctions",
										"lambda:AddPermission",
										"lambda:InvokeFunction",
										"lambda:InvokeAsync"
									],
									"Resource": "*"
								}
							]
						}
					}
				],
				"ManagedPolicyArns": [
					"arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole",
					"arn:aws:iam::aws:policy/AWSXRayDaemonWriteAccess",
					"arn:aws:iam::aws:policy/service-role/AWSLambdaVPCAccessExecutionRole",
					"arn:aws:iam::aws:policy/service-role/AWSLambdaRole"
				],
				"Tags": []
			}
		},
        "AliasEnviarCorreoLambdaPRD": {
            "Type": "AWS::Lambda::Alias",
            "DeletionPolicy": "Delete",
            "UpdateReplacePolicy": "Delete",
            "Properties": {
                "Description": "Ambiente de PRD EnviarCorreoLambda",
                "FunctionName": {
                    "Ref": "EnviarCorreoLambda"
                },
                "FunctionVersion": "$LATEST",
                "Name": "PRD"
            }
        },
        "EnviarCorreoLambda": {
            "DeletionPolicy": "Delete",
            "UpdateReplacePolicy": "Delete",
            "Type": "AWS::Lambda::Function",
            "Properties": {
                "FunctionName": "EnviarCorreoLambda",
                "Handler": "app.handler",
                "Runtime": "nodejs24.x",
                "Code": {
                    "ZipFile": "exports.handler = async (event, context) => {\n  return { statusCode: 200, body: 'Connected.' };\n};\n"
                },
                "Description": "Lambda en node 24 para enviar correos",
                "MemorySize": 128,
                "Timeout": 30,
                "Environment": {
                    "Variables": {}
                },
                "Role": {
                    "Fn::GetAtt": [
                        "FuncionesGlobalesRolLambdas",
                        "Arn"
                    ]
                },
                "Layers": [],
                "TracingConfig": {
                    "Mode": "Active"
                },
                "RuntimeManagementConfig": {
                    "UpdateRuntimeOn": "Auto"
                },
                "Tags": [
                    {
                        "Key": {
                            "Ref": "TagKey1"
                        },
                        "Value": {
                            "Ref": "TagValue1"
                        }
                    }
                ]
            }
        }
    },
    "Parameters": {
        "TagKey1": {
            "Type": "String",
            "Default": "Proyecto"
        },
        "TagValue1": {
            "Type": "String",
            "Default": "FuncionesGlobales"
        }
    }
}